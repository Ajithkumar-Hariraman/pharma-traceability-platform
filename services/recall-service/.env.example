PORT=3009
DATABASE_URL=postgresql://recall_owner:replace-with-a-strong-recall-password@127.0.0.1:55432/recall
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-bytes-secret
PRODUCT_SERVICE_URL=http://127.0.0.1:3003
BATCH_SERVICE_URL=http://127.0.0.1:3004
SERIALIZATION_SERVICE_URL=http://127.0.0.1:3005
REFERENCE_TIMEOUT_MS=3000
EVENT_TRANSPORT=kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=recall-service
KAFKA_CONSUMER_GROUP_ID=verification-invalidation-v1

# Optional acceleration; rediss:// supports managed TLS endpoints later.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=500
VERIFICATION_CACHE_TTL_SECONDS=30
VERIFICATION_UNKNOWN_TTL_SECONDS=5
VERIFICATION_RATE_LIMIT=60
VERIFICATION_RATE_WINDOW_SECONDS=60

VERIFICATION_PROJECTION_ENABLED=true
DYNAMODB_TABLE=pharma-verification
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TIMEOUT_MS=1000
# Local only. Omit these in AWS to use the normal SDK credential provider chain.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
