generator client {
 provider = "prisma-client-js"
 output = "../generated/client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum PackagingLevel {
 INNER
 CASE
 PALLET
}
enum ContainerStatus {
 ACTIVE
 CLOSED
 DECOMMISSIONED
}
enum ChildType {
 SERIALIZED_ITEM
 CONTAINER
}
model AggregateContainer {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 containerCode String @db.VarChar(100)
 packagingLevel PackagingLevel
 status ContainerStatus @default(ACTIVE)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 children AggregationRelation[] @relation("Parent")
 parent AggregationRelation? @relation("Child")
 @@unique([organizationId, containerCode])
 @@unique([organizationId, id])
 @@index([organizationId])
 @@index([packagingLevel])
 @@index([status])
}
model AggregationRelation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 parentContainerId String @db.Uuid
 childType ChildType
 childSerializedItemId String? @unique @db.Uuid
 childContainerId String? @unique @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 parent AggregateContainer @relation("Parent", fields: [organizationId, parentContainerId], references: [organizationId, id], onDelete: Restrict)
 child AggregateContainer? @relation("Child", fields: [childContainerId], references: [id], onDelete: Restrict)
 @@index([organizationId])
 @@index([parentContainerId])
}

enum OutboxStatus {
 PENDING
 PUBLISHING
 PUBLISHED
 FAILED
}
model OutboxEvent {
 id String @id @default(uuid()) @db.Uuid
 eventId String @unique @db.VarChar(200)
 eventType String @db.VarChar(100)
 eventVersion Int
 organizationId String @db.Uuid
 aggregateType String @db.VarChar(50)
 aggregateId String @db.Uuid
 envelope Json @db.JsonB
 status OutboxStatus @default(PENDING)
 attempts Int @default(0)
 availableAt DateTime @default(now()) @db.Timestamptz(3)
 claimToken String? @db.Uuid
 publishedAt DateTime? @db.Timestamptz(3)
 lastError String? @db.VarChar(200)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status, availableAt, createdAt])
 @@index([status, publishedAt])
 @@index([organizationId, aggregateType, aggregateId])
}
