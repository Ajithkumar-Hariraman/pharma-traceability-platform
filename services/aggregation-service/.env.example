PORT=3006
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgresql://aggregation_owner:replace-me@127.0.0.1:55432/aggregation
INTERNAL_IDENTITY_SECRET=replace-with-shared-at-least-32-byte-secret
SERIALIZATION_SERVICE_URL=http://127.0.0.1:3005
SERIALIZATION_SERVICE_TIMEOUT_MS=2000

# Use kafka to migrate this service from HTTP capture.
EVENT_TRANSPORT=http
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aggregation-service
KAFKA_CONSUMER_GROUP_ID=traceability-v1
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Both modes persist events transactionally and publish asynchronously.
TRACEABILITY_SERVICE_URL=http://127.0.0.1:3007
# HTTP capture uses TRACE_CAPTURE_SECRET, or INTERNAL_IDENTITY_SECRET when unset.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000
OUTBOX_LEASE_MS=60000
OUTBOX_RETENTION_DAYS=7
