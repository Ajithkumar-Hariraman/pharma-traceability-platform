PORT=3005
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgresql://serialization_owner:replace-me@127.0.0.1:55432/serialization
INTERNAL_IDENTITY_SECRET=replace-with-shared-at-least-32-byte-secret
BATCH_SERVICE_URL=http://127.0.0.1:3004
BATCH_SERVICE_TIMEOUT_MS=2000

TRACEABILITY_SERVICE_URL=http://127.0.0.1:3007
TRACE_CAPTURE_SECRET=replace-with-separate-32-random-bytes

# Use kafka to migrate this service from HTTP capture.
EVENT_TRANSPORT=http
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=serialization-service
KAFKA_CONSUMER_GROUP_ID=traceability-v1
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
