PORT=3007
DATABASE_URL=postgresql://traceability_owner:CHANGE_ME@127.0.0.1:55432/traceability?schema=public
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-random-bytes
TRACE_CAPTURE_SECRET=replace-with-separate-32-random-bytes

# Use kafka to migrate this service from HTTP capture.
EVENT_TRANSPORT=http
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=traceability-service
KAFKA_CONSUMER_GROUP_ID=traceability-v1
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
