PORT=3008
DATABASE_URL=postgresql://shipment_owner:replace-with-a-strong-shipment-password@127.0.0.1:55432/shipment
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-bytes-secret
ORGANIZATION_SERVICE_URL=http://127.0.0.1:3002
SERIALIZATION_SERVICE_URL=http://127.0.0.1:3005
AGGREGATION_SERVICE_URL=http://127.0.0.1:3006
TRACEABILITY_SERVICE_URL=http://127.0.0.1:3007
TRACE_CAPTURE_SECRET=replace-with-at-least-32-bytes-secret
REFERENCE_TIMEOUT_MS=2000

# Use kafka to migrate this service from HTTP capture.
EVENT_TRANSPORT=http
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=shipment-service
KAFKA_CONSUMER_GROUP_ID=traceability-v1
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Kafka mode persists events transactionally and publishes asynchronously.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000
OUTBOX_LEASE_MS=60000
OUTBOX_RETENTION_DAYS=7

# Local MinIO only. In AWS omit endpoint and credentials; use the default provider chain.
S3_BUCKET=pharma-documents
AWS_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=pharma-local
AWS_SECRET_ACCESS_KEY=replace-with-local-secret
S3_UPLOAD_EXPIRY_SECONDS=300
S3_DOWNLOAD_EXPIRY_SECONDS=120
DOCUMENT_MAX_FILE_SIZE=10485760
DOCUMENT_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/csv
DOCUMENT_PENDING_TTL_SECONDS=3600
